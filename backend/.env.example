# ==============================================================
# SIH Training Centre AI Monitoring System - Backend Environment
# ==============================================================

# Core Application Settings
APP_NAME="SIH-Centre-AI-Monitoring"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api/v1"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# MySQL Database Connection (Database name: sih_monitoring)
# Format: mysql+pymysql://USERNAME:PASSWORD@localhost:3306/sih_monitoring
DATABASE_URL="mysql+pymysql://root:your_mysql_password_here@localhost:3306/sih_monitoring"

# JWT Authentication
JWT_SECRET_KEY="your_super_secret_jwt_key_here_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Directories
STORAGE_ROOT="storage"
SNAPSHOT_DIR="snapshots"
VIDEO_DIR="videos"
EVIDENCE_DIR="evidence"
DATASET_DIR="datasets"
AI_MODELS_DIR="ai_models"

# Compliance Engine Parameters
DEFAULT_ATTENDANCE_TOLERANCE=2
COMPLIANCE_ATTENDANCE_TOLERANCE=2
COMPLIANCE_AGGREGATION_METHOD="MEDIAN"
SNAPSHOT_INTERVAL_SECONDS=10
MAX_SNAPSHOTS_PER_SESSION=300

# YOLO26 Attendance AI Pipeline
ATTENDANCE_MODEL_FAMILY="YOLO26"
ATTENDANCE_MODEL_TYPE="yolo26"
ATTENDANCE_MODEL_NAME="YOLO26-Attendance"
ATTENDANCE_MODEL_VERSION="v1-baseline"
ATTENDANCE_MODEL_PATH="models/attendance/baseline/yolov8n.pt"
ATTENDANCE_CONFIDENCE_THRESHOLD=0.40
ATTENDANCE_IOU_THRESHOLD=0.45
ATTENDANCE_DEVICE="cpu"
ATTENDANCE_SAVE_ANNOTATED=True

# YOLO26 Infrastructure AI Pipeline
INFRASTRUCTURE_MODEL_FAMILY="YOLO26"
INFRASTRUCTURE_MODEL_TYPE="yolo26"
INFRASTRUCTURE_MODEL_NAME="YOLO26-Infrastructure"
INFRASTRUCTURE_MODEL_VERSION="v1-baseline"
INFRASTRUCTURE_MODEL_PATH="models/infrastructure/baseline/yolov8n.pt"
INFRASTRUCTURE_CONFIDENCE_THRESHOLD=0.40
INFRASTRUCTURE_IOU_THRESHOLD=0.50
INFRASTRUCTURE_DEVICE="cpu"
INFRASTRUCTURE_SAVE_ANNOTATED=True
